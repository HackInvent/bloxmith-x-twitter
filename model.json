{
  "kind": "x_twitter",
  "version": "0.1.0",
  "title": "X (Twitter)",
  "description": "Publish, search and read posts on X through the X API v2.",
  "repository_url": "https://github.com/HackInvent/bloxmith-x-twitter",
  "bloxsmith_compatibility": [
    "1.0.9"
  ],
  "tested_with_bloxsmith": "1.0.9",
  "prerequisites": [
    {
      "type": "manual",
      "name": "Linux/POSIX with Python 3.10+ and TLS support, an X developer app with OAuth 2.0 enabled and an X API access level that includes the operations used, a user-context grant (tweet.read, tweet.write, users.read, offline.access, media.write) and/or an app-only bearer token stored in the BloxSmith wallet, and outbound HTTPS access to api.x.com."
    }
  ],
  "locales": {
    "en": "locales/en.json",
    "fr": "locales/fr.json"
  },
  "ports": {
    "inputs": [
      {
        "id": 1,
        "name": "request",
        "title": "request",
        "accepts": [
          "application/json",
          "text/plain",
          "message/*"
        ],
        "multiplicity": "one",
        "required": false,
        "execution_requirement": "not_required_for_execution"
      },
      {
        "id": 2,
        "name": "media",
        "title": "media",
        "accepts": [
          "file/path",
          "image/path",
          "text/plain",
          "application/json",
          "message/*"
        ],
        "multiplicity": "one",
        "required": false,
        "execution_requirement": "not_required_for_execution"
      }
    ],
    "outputs": [
      {
        "id": 1,
        "name": "posts",
        "title": "posts",
        "emits": [
          "application/json",
          "message/*"
        ],
        "multiplicity": "many"
      },
      {
        "id": 2,
        "name": "result",
        "title": "result",
        "emits": [
          "application/json",
          "message/*"
        ],
        "multiplicity": "many"
      },
      {
        "id": 3,
        "name": "error",
        "title": "error",
        "emits": [
          "application/json",
          "message/*"
        ],
        "multiplicity": "many"
      }
    ]
  },
  "config": {
    "enabled": false,
    "secret_ref": "",
    "bearer_secret_ref": "",
    "operation": "search_recent",
    "allowed_operations": [
      "search_recent"
    ],
    "allow_writes": false,
    "allow_delete": false,
    "media_root": "",
    "max_media_bytes": 5242880,
    "max_weighted_length": 280,
    "page_size": 10,
    "max_pages": 1,
    "timeout_sec": 60,
    "max_retries": 2,
    "max_retry_wait_sec": 30,
    "max_request_bytes": 65536,
    "max_response_bytes": 4194304,
    "api_base_url": "https://api.x.com",
    "ca_file": ""
  },
  "port_capabilities": {
    "can_add_inputs": false,
    "can_add_outputs": false
  },
  "runtime": {
    "initial_state": "waiting",
    "runtime_executable": true,
    "active_worker": true,
    "centralized_executor": "generic",
    "centralized_dependency_mode": "all_inputs",
    "active_execution_policy": "on_each_event",
    "file_browser": true
  },
  "ui_assets": {
    "modal": [
      {
        "kind": "css",
        "path": "assets/css/properties.css"
      },
      {
        "kind": "css",
        "path": "assets/css/settings.css"
      },
      {
        "kind": "js",
        "path": "assets/js/properties.js"
      },
      {
        "kind": "js",
        "path": "assets/js/settings.js"
      },
      {
        "kind": "js",
        "path": "assets/js/block_modal.js"
      }
    ],
    "inspector_panel": [
      {
        "kind": "css",
        "path": "assets/css/properties.css"
      },
      {
        "kind": "css",
        "path": "assets/css/settings.css"
      },
      {
        "kind": "js",
        "path": "assets/js/properties.js"
      },
      {
        "kind": "js",
        "path": "assets/js/settings.js"
      },
      {
        "kind": "js",
        "path": "assets/js/inspector_panel.js"
      }
    ],
    "node_card": [
      {
        "kind": "css",
        "path": "assets/css/node_card.css"
      }
    ]
  }
}
